# ── Obrigatórias ─────────────────────────────────────────────
DATABASE_URL=                 # Neon (connection string pooled)
APP_URL=http://localhost:3000 # URL público (https://<projeto>.vercel.app em produção): define issuer e resource OAuth
SESSION_SECRET=               # >= 32 caracteres aleatórios (openssl rand -base64 48)

# ── Bootstrap do admin (1º arranque; troca de password obrigatória) ──
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Comportamento ────────────────────────────────────────────
SIGNUP_MODE=approval          # open | approval | invite_only
ACCESS_TOKEN_TTL=3600
JOB_TIMEOUT_SECONDS=50        # <= maxDuration da função (60 s no código)
APPROVAL_TIMEOUT_SECONDS=30   # janela para aprovar/negar no painel
RELAY_POLL_IDLE_SECONDS=20
RELAY_POLL_ACTIVE_SECONDS=1
RELAY_ACTIVE_WINDOW_MINUTES=5

# ── Segurança opcional ───────────────────────────────────────
REQUIRE_ADMIN_TOTP=0          # 1 = admins sem 2FA são enviados para /security
TOTP_ENC_KEY=                 # opcional; por defeito usa SESSION_SECRET (rodá-lo invalida os 2FA)
