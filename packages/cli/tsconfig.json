{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "outDir": "dist", "rootDir": "src", "strict": true, "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true, "allowImportingTsExtensions": true
  },
  "include": ["src"], "exclude": ["src/**/*.test.ts"]
}
